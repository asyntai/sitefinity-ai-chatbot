<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Asyntai.Sitefinity.AiChatbot</id>
    <version>1.0.0</version>
    <title>Asyntai AI Chatbot for Sitefinity</title>
    <authors>Asyntai</authors>
    <owners>Asyntai</owners>
    <license type="expression">MIT</license>
    <projectUrl>https://asyntai.com/documentation/installation/sitefinity/</projectUrl>
    <repository type="git" url="https://github.com/asyntai/sitefinity-ai-chatbot" />
    <icon>images\icon.png</icon>
    <readme>README.md</readme>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Adds the Asyntai AI chat assistant to every public page of your Sitefinity CMS website. The chatbot answers visitor questions from your own pages in more than 80 languages and collects leads. Set it up in Administration > Settings > Advanced, with multisite support.</description>
    <summary>AI chatbot for Sitefinity CMS websites.</summary>
    <tags>sitefinity ai chatbot chat livechat customer-support asyntai</tags>
    <copyright>Copyright (c) 2026 Asyntai</copyright>
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <dependency id="Telerik.Sitefinity.Core" version="14.0.7700" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="src\Asyntai.Sitefinity.AiChatbot\bin\Release\net48\Asyntai.Sitefinity.AiChatbot.dll" target="lib\net48" />
    <file src="src\Asyntai.Sitefinity.AiChatbot\bin\Release\net48\Asyntai.Sitefinity.AiChatbot.xml" target="lib\net48" />
    <file src="content\web.config.install.xdt" target="content\net48" />
    <file src="content\web.config.uninstall.xdt" target="content\net48" />
    <file src="images\icon.png" target="images" />
    <file src="README.md" />
    <file src="LICENSE" />
  </files>
</package>
